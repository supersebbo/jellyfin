FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Jellyfin.LiveTv/Jellyfin.LiveTv.csproj && \
    dotnet restore MediaBrowser.Model/MediaBrowser.Model.csproj
RUN dotnet build src/Jellyfin.LiveTv/Jellyfin.LiveTv.csproj -c Release --no-restore && \
    dotnet build MediaBrowser.Model/MediaBrowser.Model.csproj -c Release --no-restore

FROM jellyfin/jellyfin:10.11.11
COPY --from=build /src/src/Jellyfin.LiveTv/bin/Release/net9.0/Jellyfin.LiveTv.dll /jellyfin/
COPY --from=build /src/MediaBrowser.Model/bin/Release/net9.0/MediaBrowser.Model.dll /jellyfin/
